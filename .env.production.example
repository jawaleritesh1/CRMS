# ==============================================================================
# Ralix CRM (v5.1.0-HARDENED) — Production Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_database_password_32chars
POSTGRES_DB=ralix_crm

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=replace_with_a_random_cryptographic_key_at_least_32_characters

# Token Expirations
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Database Initialization
# Set to 'true' on the very first boot to seed capabilities catalogue and admin user
RUN_SEED=true

# Telephony Configuration ('mock' for testing, 'knowlarity' for production)
TELEPHONY_PROVIDER=mock
KNOWLARITY_BASE_URL=https://sr.knowlarity.com/newsr/api/v1/click2call/
KNOWLARITY_API_KEY=
KNOWLARITY_AUTH_TOKEN=
KNOWLARITY_K_NUMBER=+918047100000
KNOWLARITY_CALLER_ID=+918047100000

# Meta Lead Ads Integration
META_VERIFY_TOKEN=ralix_meta_verify_token_2026
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Domain Name (for SSL / Nginx)
DOMAIN_NAME=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
