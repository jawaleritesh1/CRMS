# ==============================================================================
# Ralix CRM - Environment Variables Configuration (v5.1.0-HARDENED)
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL Database (Neon pooled vs direct)
DATABASE_URL="postgresql://user:password@localhost:5432/ralix_crm?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://user:password@localhost:5432/ralix_crm?schema=public&sslmode=prefer"

# Redis Cache & BullMQ Queue Store
REDIS_URL="redis://localhost:6379"

# Security & Authentication Tokens (DEC-001 interim defaults)
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-for-security"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Argon2id Hashing Parameters (DEC-003 RFC 9106 baseline)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting Interim Defaults (DEC-010)
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WEBHOOK_PER_MIN=60
RATE_LIMIT_API_PER_MIN=600

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000"
